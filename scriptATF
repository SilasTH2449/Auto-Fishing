-- สูตรคำนวณตัวชี้มินิเกมตามโค้ดแท้ของ WarZ
local function markerAt(serverTime, biteAt, speed)
    local v = (serverTime - biteAt) * speed % 2
    if v < 0 then v = v + 2 end
    if v < 1 then return v end
    return 2 - v
end

-- สแกนหากระเป๋า เบ็ด และเหยื่อในตัวผู้เล่น
local function scanInventory()
    table.clear(DetectedRods)
    table.clear(DetectedBaits)

    local activeSlot = tonumber(LocalPlayer:GetAttribute("CSGO_ActiveSlot")) or 1
    local activeCatId = tostring(LocalPlayer:GetAttribute("CSGO_CatalogId") or "")
    if activeCatId ~= "" and (string.find(activeCatId, "Rod") or string.find(activeCatId, "Fishing")) then
        table.insert(DetectedRods, {
            slot = activeSlot,
            id = activeCatId,
            name = (Config and Config.ShopItem and Config.ShopItem(activeCatId) and Config.ShopItem(activeCatId).Name) or activeCatId,
            equipped = true,
        })
    end

    pcall(function()
        if PlayerGui then
            local csgoUi = PlayerGui:FindFirstChild("CSGO_UI")
            if csgoUi then
                local hud = csgoUi:FindFirstChild("Hud")
                local slotCards = hud and hud:FindFirstChild("SlotCards")
                if slotCards then
                    for i = 1, 6 do
                        local slotFrame = slotCards:FindFirstChild("Slot" .. tostring(i))
                        if slotFrame then
                            local nameLab = slotFrame:FindFirstChild("Name")
                            local qtyLab = slotFrame:FindFirstChild("Qty")
                            local itemName = (nameLab and nameLab.Text) or ""
                            local itemQty = (qtyLab and qtyLab.Text) or "1"

                            if itemName ~= "" then
                                local lowerName = string.lower(itemName)
                                if string.find(lowerName, "rod") or string.find(lowerName, "เบ็ด") then
                                    local found = false
                                    for _, r in ipairs(DetectedRods) do
                                        if r.slot == i then found = true break end
                                    end
                                    if not found then
                                        table.insert(DetectedRods, {
                                            slot = i,
                                            id = "Slot" .. tostring(i),
                                            name = itemName,
                                            qty = itemQty,
                                        })
                                    end
                                elseif string.find(lowerName, "bait") or string.find(lowerName, "เหยื่อ") or string.find(lowerName, "worm") or string.find(lowerName, "chubby") then
                                    local found = false
                                    for _, b in ipairs(DetectedBaits) do
                                        if b.slot == i then found = true break end
                                    end
                                    if not found then
                                        table.insert(DetectedBaits, {
                                            slot = i,
                                            id = "Slot" .. tostring(i),
                                            name = itemName,
                                            qty = itemQty,
                                        })
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end)

    if #DetectedRods == 0 then
        table.insert(DetectedRods, {slot = 1, id = "RodDefault", name = "เบ็ด (ช่อง 1 - มาตรฐาน)"})
        table.insert(DetectedRods, {slot = 2, id = "RodSecondary", name = "เบ็ด (ช่อง 2)"})
    end
    if #DetectedBaits == 0 then
        table.insert(DetectedBaits, {slot = 4, id = "BaitChubby", name = "เหยื่อ (ช่อง 4 - มาตรฐาน)"})
        table.insert(DetectedBaits, {slot = 3, id = "BaitSlot3", name = "เหยื่อ (ช่อง 3)"})
        table.insert(DetectedBaits, {slot = 5, id = "BaitSlot5", name = "เหยื่อ (ช่อง 5)"})
        table.insert(DetectedBaits, {slot = 7, id = "BaitBag7", name = "เหยื่อ (กระเป๋าช่อง 7)"})
    end
end

local function getTargetRodSlot()
    if Settings.SelectedRodSlot ~= "auto" then
        return tonumber(Settings.SelectedRodSlot) or 1
    end
    local held = tonumber(LocalPlayer:GetAttribute("CSGO_ActiveSlot"))
    if held and held >= 1 and held <= 6 then
        for _, r in ipairs(DetectedRods) do
            if r.slot == held then return held end
        end
    end
    if #DetectedRods > 0 then
        return DetectedRods[1].slot
    end
    return 1
end

local function getTargetBaitSlot()
    if Settings.SelectedBaitSlot ~= "auto" then
        return tonumber(Settings.SelectedBaitSlot) or 4
    end
    if #DetectedBaits > 0 then
        return DetectedBaits[1].slot
    end
    return 4
end

local function getCastTargetPoint()
    local cam = Workspace.CurrentCamera
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    if cam then
        local camPos = cam.CFrame.Position
        local look = cam.CFrame.LookVector
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = {char}
        rayParams.IgnoreWater = true
        local hit = Workspace:Raycast(camPos, look * 60, rayParams)
        if hit and (Vector3.new(hit.Position.X - camPos.X, 0, hit.Position.Z - camPos.Z)).Magnitude <= 50 then
            return hit.Position
        end
        return camPos + look * 35
    elseif hrp then
        return hrp.Position + hrp.CFrame.LookVector * 28 - Vector3.new(0, 3, 0)
    end
    return Vector3.new(0, 0, 0)
end

