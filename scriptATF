    -- ══════════════════ CORE FISHING ENGINE ══════════════════
    local function updateUIStatus(text, color)
        Stats.Status = text
        StatusLabel.Text = "สถานะ: " .. text
        if color then
            StatusLabel.TextColor3 = color
            StatusDot.BackgroundColor3 = color
        else
            StatusLabel.TextColor3 = Theme.Text
            StatusDot.BackgroundColor3 = Theme.Green
        end
        StatsLabel.Text = string.format("สำเร็จ: %d  |  หลุด: %d  |  ของล่าสุด: %s", Stats.Catches, Stats.Misses, Stats.LastCatch)
    end

    local function equipRodIfNeeded(rodSlot)
        if not Settings.AutoEquipRod then return end
        local curSlot = tonumber(LocalPlayer:GetAttribute("CSGO_ActiveSlot"))
        if curSlot ~= rodSlot and FishingRemotes.SwitchWeaponRequest then
            FishingRemotes.SwitchWeaponRequest:FireServer(rodSlot)
            task.wait(0.35)
        end
    end

    local function doCast()
        if not FishingRemotes.FishingStart then
            updateUIStatus("ไม่พบ Remote: FishingStart!", Theme.Red)
            return false
        end

        scanInventory()
        local rodSlot  = getTargetRodSlot()
        local baitSlot = getTargetBaitSlot()
        local targetPos = getCastTargetPoint()

        equipRodIfNeeded(rodSlot)

        ActiveState.Phase = "cast"
        ActiveState.CastTime = os.clock()
        ActiveState.IsReeling = false

        updateUIStatus("กำลังเหวี่ยงเบ็ด... (Casting)", Theme.Yellow)
        FishingRemotes.FishingStart:FireServer(rodSlot, baitSlot, targetPos)
        return true
    end

    local function doReel()
        if ActiveState.IsReeling then return end
        ActiveState.IsReeling = true

        if FishingRemotes.FishingReel and ActiveState.CastId then
            local now = Workspace:GetServerTimeNow()
            FishingRemotes.FishingReel:FireServer(ActiveState.CastId, now)
            updateUIStatus("ตวัดเบ็ดแล้ว! รอผลลัพธ์...", Theme.Yellow)
        end
    end

    local function doCancel()
        if FishingRemotes.FishingCancel and ActiveState.CastId then
            FishingRemotes.FishingCancel:FireServer(ActiveState.CastId)
        end
        ActiveState.Phase = "idle"
        ActiveState.CastId = nil
        ActiveState.IsReeling = false
        updateUIStatus("ยกเลิกการตกแล้ว (Canceled)", Theme.TextMuted)
    end

    local function handleReelPhase(state)
        ActiveState.Phase      = "reel"
        ActiveState.CastId     = state.castId
        ActiveState.BiteAt     = state.biteAt or Workspace:GetServerTimeNow()
        ActiveState.Speed      = state.speed or 1
        ActiveState.ZoneCenter = state.zoneCenter or 0.5
        ActiveState.ZoneWidth  = state.zoneWidth or 0.25
        ActiveState.Deadline   = state.deadline or (ActiveState.BiteAt + 5)
        ActiveState.IsReeling  = false

        updateUIStatus("ปลากินแล้ว! เล็งกลางแถบเขียว...", Theme.Green)

        task.spawn(function()
            while ActiveState.Phase == "reel" and not ActiveState.IsReeling do
                local now = Workspace:GetServerTimeNow()
                if (ActiveState.Deadline - now) <= 0.15 then
                    doReel()
                    break
                end

                local curPos = markerAt(now, ActiveState.BiteAt, ActiveState.Speed)
                local diff = math.abs(curPos - ActiveState.ZoneCenter)

                if diff <= (ActiveState.ZoneWidth * 0.35) then
                    doReel()
                    break
                end

                RunService.Heartbeat:Wait()
            end
        end)
    end

    if FishingRemotes.FishingState then
        FishingRemotes.FishingState.OnClientEvent:Connect(function(state)
            if typeof(state) ~= "table" or not state.phase then return end

            if state.phase == "cast" then
                ActiveState.CastId = state.castId
                ActiveState.Phase  = "cast"
                updateUIStatus("เหวี่ยงเบ็ดแล้ว... รอปลากิน (Waiting for bite)", Theme.Yellow)

            elseif state.phase == "reel" then
                handleReelPhase(state)

            elseif state.phase == "result" then
                ActiveState.Phase = "result"
                ActiveState.IsReeling = false

                if state.ok then
                    Stats.Catches = Stats.Catches + 1
                    local itemName = "ปลา"
                    if state.rewards and #state.rewards > 0 then
                        local r = state.rewards[1]
                        itemName = string.format("%s ×%d", tostring(r.name or r.itemId or "ปลา"), tonumber(r.qty) or 1)
                    elseif state.name then
                        itemName = string.format("%s ×%d", tostring(state.name or state.itemId or "ปลา"), tonumber(state.qty) or 1)
                    end
                    Stats.LastCatch = itemName
                    updateUIStatus("✓ ตกสำเร็จ! ได้: " .. itemName, Theme.Green)
                else
                    Stats.Misses = Stats.Misses + 1
                    local reason = tostring(state.message or "ปลาหลุด")
                    updateUIStatus("✗ พลาด: " .. reason, Theme.Red)
                end

                if Settings.AutoFishEnabled then
                    task.delay(Settings.CastDelay, function()
                        if Settings.AutoFishEnabled and ActiveState.Phase == "result" then
                            doCast()
                        end
                    end)
                end

            elseif state.phase == "cancel" then
                ActiveState.Phase = "idle"
                ActiveState.CastId = nil
                ActiveState.IsReeling = false
                updateUIStatus("รอบตกปลาถูกยกเลิก", Theme.TextMuted)

                if Settings.AutoFishEnabled then
                    task.delay(1.5, function()
                        if Settings.AutoFishEnabled and ActiveState.Phase == "idle" then
                            doCast()
                        end
                    end)
                end
            end
        end)
    end

    -- Watchdog Timer: ป้องกันเหวี่ยงค้างเกิน 22 วินาที
    task.spawn(function()
        while true do
            task.wait(2)
            if Settings.AutoFishEnabled and ActiveState.Phase == "cast" then
                if (os.clock() - ActiveState.CastTime) > 22 then
                    updateUIStatus("ระบบตรวจสอบ: รอปลานานเกินไป กำลังเหวี่ยงใหม่...", Theme.Yellow)
                    doCancel()
                    task.wait(1)
                    if Settings.AutoFishEnabled then
                        doCast()
                    end
                end
            end
        end
    end)

    local function setAutoFishing(enabled)
        Settings.AutoFishEnabled = enabled
