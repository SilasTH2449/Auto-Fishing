            updateUIStatus("เริ่มระบบตกปลาอัตโนมัติ...", Theme.Green)
            doCast()
        else
            MainToggleBtn.Text = "🎣  เปิดตกปลา AUTO : ปิด (OFF)"
            MainToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
            MainToggleStroke.Color = Theme.Border
            doCancel()
            updateUIStatus("ปิดระบบตกปลาแล้ว (Idle)", Theme.TextMuted)
        end
    end

