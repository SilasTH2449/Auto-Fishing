            end
        end)
    elseif writefile then
        pcall(function()
            writefile(SAVE_FILE_NAME, "")
        end)
    end
end

-- ══════════════════ KEY VERIFICATION ENGINE ══════════════════
-- ฟังก์ชันตรวจสอบคีย์กับ GitHub และระบบ HWID Lock
local function verifyKeyOnline(inputKey)
    inputKey = string.gsub(inputKey or "", "^%s*(.-)%s*$", "%1") -- ตัดช่องว่างหัวท้าย
    if inputKey == "" then
        return false, "กรุณากรอกคีย์ก่อนกดยืนยัน"
    end

    -- ป้องกัน GitHub CDN Cache ด้วยการใส่ timestamp parameter
    local urlWithBust = GITHUB_KEYS_URL .. "?t=" .. tostring(os.time())
    local body = fetchUrl(urlWithBust)
    if not body or body == "" then
        body = fetchUrl(GITHUB_KEYS_URL)
    end
    if not body or body == "" then
        return false, "ไม่สามารถเชื่อมต่อ GitHub ได้ กรุณาตรวจสอบอินเทอร์เน็ต"
    end

    local myHwid = getHWID()
    local keyFound = false
    local hwidMismatch = false

    for line in string.gmatch(body, "[^\r\n]+") do
        line = string.gsub(line, "^%s*(.-)%s*$", "%1")
        if line ~= "" and not string.find(line, "^#") and not string.find(line, "^%-%-") then
            -- ตรวจสอบว่าบรรทัดมี ":" (รูปแบบ KEY:HWID เช่น UNIQUE-KEY-xxx:7B3F-...)
            local colonIdx = string.find(line, ":")
            if colonIdx then
                local k = string.sub(line, 1, colonIdx - 1)
                local h = string.sub(line, colonIdx + 1)
                k = string.gsub(k, "^%s*(.-)%s*$", "%1")
                h = string.gsub(h, "^%s*(.-)%s*$", "%1")
                if k == inputKey then
                    keyFound = true
                    if h == myHwid then
                        saveKeyLocal(inputKey, myHwid)
                        return true, "คีย์ถูกต้อง! ยินดีต้อนรับเข้าสู่ระบบ"
                    else
                        hwidMismatch = true
                    end
                end
            else
                -- รูปแบบ KEY ล้วน (ยังไม่ผูก HWID บน GitHub)
                if line == inputKey then
                    keyFound = true
                    -- ตรวจสอบ HWID Lock ระดับเครื่อง (Local Binding)
                    local savedData = readKeyLocal()
                    if savedData and savedData.key == inputKey and savedData.hwid and savedData.hwid ~= myHwid then
                        return false, "คีย์นี้ถูกล็อคกับเครื่องอื่นแล้ว! (HWID Mismatch)"
                    end
                    saveKeyLocal(inputKey, myHwid)
                    return true, "คีย์ถูกต้อง! ยินดีต้อนรับเข้าสู่ระบบ"
                end
            end
        end
    end

    if hwidMismatch then
        return false, "คีย์นี้ถูกล็อคกับเครื่องอื่นแล้ว! (HWID Lock)"
    end
    if not keyFound then
        return false, "คีย์ไม่ถูกต้อง หรือหมดอายุแล้ว"
    end

    return false, "เกิดข้อผิดพลาดในการตรวจสอบคีย์"
end

